{
   "action": {
      "default_icon": {
         "32": "images/browser_action_32.png"
      },
      "default_popup": "index.html#popup",
      "default_title": "Snooze This Tab"
   },
   "author": "csandapp",
   "background": {
      "service_worker": "static/js/background.js",
      "type": "module"
   },
   "commands": {
      "_execute_action": {
         "description": "Snooze active tab",
         "suggested_key": {
            "default": "Alt+S"
         }
      },
      "new_todo_page": {
         "description": "New todo tab",
         "global": true,
         "suggested_key": {
            "default": "Ctrl+Shift+1"
         }
      },
      "open_snoozed_list": {
         "description": "Open snoozed tabs list",
         "suggested_key": {
            "default": "Alt+J"
         }
      },
      "repeat_last_snooze": {
         "description": "Repeat last snooze action",
         "suggested_key": {
            "default": "Alt+Shift+S"
         }
      }
   },
   "description": "Save articles, videos and todos for later. They'll magically reopen when you need them.",
   "icons": {
      "128": "images/extension_icon_128.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Tab Snooze - Manifest V3 (MINE)",
   "options_page": "index.html#options/settings",
   "permissions": [ "offscreen", "tabs", "activeTab", "alarms", "storage", "notifications", "idle" ],
   "short_name": "Tab Snooze (MINE)",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "12.0.1",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "images/*", "fonts/*", "sounds/*", "offscreen.html" ]
   } ]
}
